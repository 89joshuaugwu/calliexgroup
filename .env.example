# ── Firebase client SDK (safe to expose — these are public identifiers) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=calliexgroup-cms.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=calliexgroup-cms
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=calliexgroup-cms.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server-only, from a service-account JSON) ──
# Paste the three fields from the downloaded service-account key.
# Keep FIREBASE_ADMIN_PRIVATE_KEY quoted, with \n kept literal — the
# client.ts loader converts them back to real newlines.
FIREBASE_ADMIN_PROJECT_ID=calliexgroup-cms
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# ── Admin CMS access control ──
# Comma-separated list of the only emails allowed into /admin.
CMS_ADMIN_ALLOWED_EMAILS=info@calliexgroup.co,joshuaugwu89@gmail.com

# ── Cloudinary (unsigned direct-upload pattern, no SDK) ──
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dgxxhrwxm
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=calliexgroup_uploads

# ── Newsletter notification (optional, Gmail SMTP — same pattern as
#    every other Joshuazaza project) ──
SMTP_USER=
SMTP_APP_PASSWORD=
NEWSLETTER_NOTIFY_TO=info@calliexgroup.co

# Used server-side to build absolute URLs for revalidation, emails, etc.
NEXT_PUBLIC_SITE_URL=https://calliexgroup.co
