rules_version = '2';

// ⚠️ MANUAL PUBLISH REQUIRED — same as every other Joshuazaza Firebase
// project: these rules do NOT auto-deploy from this repo. After any edit,
// copy this file's contents into Firebase Console → Firestore Database →
// Rules → Publish. `firebase deploy --only firestore:rules` works too if
// the Firebase CLI is set up, but the Console copy-paste is the fallback
// that always works and the one to default to under time pressure.

service cloud.firestore {
  match /databases/{database}/documents {

    // Keep this list identical to CMS_ADMIN_ALLOWED_EMAILS in .env.local —
    // Firestore rules can't read server env vars, so it's duplicated here
    // on purpose. Every actual WRITE already goes through a Server Action
    // that re-verifies the caller against CMS_ADMIN_ALLOWED_EMAILS using
    // the Admin SDK (which ignores these rules entirely) — this list is
    // the second, defense-in-depth layer for direct client SDK access.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'info@calliexgroup.co',
          'joshuaugwu89@gmail.com'
        ];
    }

    // Page content (home/about/contact/brand) — public marketing copy,
    // safe to read by anyone. Only an authorized admin session may write
    // it directly; in practice writes go through savePageContent()
    // (Server Action + Admin SDK), never the client SDK.
    match /content/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Newsletter subscriber emails — readable only in /admin, and never
    // written directly by the client (subscribeNewsletter() writes via
    // the Admin SDK server-side, bypassing these rules by design).
    match /newsletter_subscribers/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
